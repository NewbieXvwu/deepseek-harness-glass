{
  "schemaVersion": 1,
  "authentication": {
    "bootstrapStatus": 303,
    "redirectLocation": "/",
    "cookieInstalled": true,
    "authenticatedRootStatus": 200
  },
  "unary": {
    "endpoint": "session/list",
    "request": {
      "type": "client-request",
      "rpcId": "fixture-session-list",
      "method": "session/list",
      "payload": {
        "args": {
          "_request": {}
        }
      }
    },
    "httpStatus": 200,
    "contentType": "application/json",
    "response": {
      "type": "server-response",
      "rpcId": "fixture-session-list",
      "result": {
        "ok": true,
        "value": {
          "items": []
        }
      }
    }
  },
  "streamOpening": {
    "eventRequest": {
      "type": "open",
      "streamId": "fixture-events",
      "endpoint": "$events",
      "payload": {
        "args": {}
      }
    },
    "eventReady": {
      "type": "item",
      "streamId": "fixture-events",
      "value": {
        "type": "ready",
        "clientId": "<fixture-client-id>",
        "host": {
          "home": "<fixture-home>"
        }
      }
    },
    "workspaceRequest": {
      "type": "open",
      "streamId": "fixture-workspaces",
      "endpoint": "workspace/follow",
      "payload": {
        "args": {}
      }
    },
    "workspaceBaseline": {
      "type": "item",
      "streamId": "fixture-workspaces",
      "value": {
        "type": "baseline",
        "value": {
          "items": [],
          "archivedSessionIds": []
        }
      }
    }
  },
  "streamDelta": {
    "trigger": {
      "type": "client-request",
      "rpcId": "fixture-workspace-create",
      "method": "workspace/create",
      "payload": {
        "args": {
          "request": {
            "path": "<fixture-workspace>"
          }
        }
      }
    },
    "frames": [
      {
        "type": "item",
        "streamId": "fixture-workspaces",
        "value": {
          "type": "upsert",
          "workspace": {
            "workspaceId": "<fixture-workspace-id>",
            "path": "<fixture-workspace>",
            "title": "workspace-a",
            "sessionIds": [],
            "createdAt": "<fixture-time>",
            "updatedAt": "<fixture-time>"
          }
        }
      },
      {
        "type": "item",
        "streamId": "fixture-workspaces",
        "value": {
          "type": "order",
          "workspaceIds": [
            "<fixture-workspace-id>"
          ]
        }
      }
    ]
  },
  "controllerCatalogs": {
    "commands": {
      "endpoint": "commands/list",
      "request": {
        "type": "client-request",
        "rpcId": "fixture-commands-list",
        "method": "commands/list",
        "payload": {
          "args": {
            "agentId": "fixture-session"
          }
        }
      },
      "httpStatus": 200,
      "contentType": "application/json",
      "response": {
        "type": "server-response",
        "rpcId": "fixture-commands-list",
        "result": {
          "ok": true,
          "value": [
            {
              "name": "compact",
              "description": "Compact older conversation history"
            },
            {
              "name": "export",
              "description": "Download this Session log as a ZIP archive"
            },
            {
              "name": "feedback",
              "description": "record feedback about this session",
              "input": {
                "hint": "<text>"
              }
            },
            {
              "name": "goal",
              "description": "set or view the goal for a long-running task",
              "input": {
                "hint": "[<objective>|clear|edit <objective>|pause|resume]",
                "images": true
              }
            },
            {
              "name": "permission",
              "description": "Switch the permission preset (sandbox mode + approval policy)",
              "input": {
                "hint": "<preset>"
              }
            },
            {
              "name": "plan",
              "description": "Enter or leave plan mode",
              "input": {
                "hint": "[off|message]",
                "images": true
              }
            }
          ]
        }
      }
    },
    "skills": {
      "endpoint": "skills/list",
      "request": {
        "type": "client-request",
        "rpcId": "fixture-skills-list",
        "method": "skills/list",
        "payload": {
          "args": {
            "request": {
              "sessionId": "fixture-session"
            }
          }
        }
      },
      "httpStatus": 200,
      "contentType": "application/json",
      "response": {
        "type": "server-response",
        "rpcId": "fixture-skills-list",
        "result": {
          "ok": true,
          "value": {
            "skills": []
          }
        }
      }
    }
  },
  "businessError": {
    "endpoint": "session/cancel",
    "request": {
      "type": "client-request",
      "rpcId": "fixture-business-error",
      "method": "session/cancel",
      "payload": {
        "args": {
          "request": {
            "sessionId": "fixture-missing-session"
          }
        }
      }
    },
    "httpStatus": 200,
    "contentType": "application/json",
    "response": {
      "type": "server-response",
      "rpcId": "fixture-business-error",
      "result": {
        "ok": false,
        "error": {
          "code": "session/not-found",
          "message": "session \"fixture-missing-session\" not found (not attached)",
          "details": {
            "sessionId": "fixture-missing-session"
          }
        }
      }
    }
  },
  "download": {
    "request": {
      "method": "GET",
      "path": "/api/session.export?sessionId=fixture-session"
    },
    "head": {
      "status": 200,
      "contentType": "application/zip",
      "contentDisposition": "attachment; filename=\"dsh-session-fixture-session.zip\""
    },
    "get": {
      "status": 200,
      "contentType": "application/zip",
      "contentDisposition": "attachment; filename=\"dsh-session-fixture-session.zip\"",
      "zipMagicHex": "504b0304"
    }
  }
}
